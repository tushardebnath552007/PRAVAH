# PRAVAH server configuration
# Reference values for the process environment. Export them in your shell,
# process manager, or hosting platform (a .env file is not loaded automatically).

# HTTP port for the Express server (default: 3000)
PORT=3000

# Runtime mode: development | production
# Use "production" to serve the built dist/ bundle and SPA fallback.
NODE_ENV=development

# Set to "true" to disable Vite HMR and file watching
# (useful on low-power hosts where continuous watching is expensive).
DISABLE_HMR=false
